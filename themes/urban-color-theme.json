      }
    },
    {
      "scope": "punctuation.definition.list.begin.markdown",
      "settings": {
        "foreground": "#f69d50"
      }
    },
    {
      "scope": [
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#6cb6ff"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#8ddb8c"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#adbac7"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#adbac7"
      }
    },
    {
      "scope": [
        "markup.underline"
      ],
      "settings": {
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": "markup.inline.raw",
      "settings": {
        "foreground": "#6cb6ff"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "background": "#5d0f12",
        "foreground": "#ff938a"
      }
    },
    {
      "scope": [
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#f47067"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "background": "#113417",
        "foreground": "#8ddb8c"
      }
    },
    {
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": {
        "background": "#682d0f",
        "foreground": "#f69d50"
      }
    },
    {
      "scope": [
        "markup.ignored",
        "markup.untracked"
      ],
      "settings": {
        "foreground": "#2d333b",
        "background": "#6cb6ff"
      }
    },
    {
      "scope": "meta.diff.range",
      "settings": {
        "foreground": "#dcbdfb",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "meta.diff.header",
      "settings": {
        "foreground": "#6cb6ff"
      }
    },
    {
      "scope": "meta.separator",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#6cb6ff"
      }
    },
    {
      "scope": "meta.output",
      "settings": {
        "foreground": "#6cb6ff"
      }
    },
    {
      "scope": [
        "brackethighlighter.tag",
        "brackethighlighter.curly",
        "brackethighlighter.round",
        "brackethighlighter.square",
        "brackethighlighter.angle",
        "brackethighlighter.quote"
      ],
      "settings": {
        "foreground": "#768390"
      }
    },
    {
      "scope": "brackethighlighter.unmatched",
      "settings": {
        "foreground": "#ff938a"
      }
    },
    {
      "scope": [
        "constant.other.reference.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#96d0ff"
      }
    },
    {
      "name": "comments -> soft green (user)",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#7CA964"
      }
    },
    {
      "name": "identifiers, params, declarations -> default text (web)",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.other.object",
        "variable.other.definition",
        "variable.parameter",
        "entity.name.variable",
        "meta.definition.variable",
        "meta.definition.variable variable.other.constant"
      ],
      "settings": {
        "foreground": "#D1D7E0"
      }
    },
    {
      "name": "property access -> blue (web)",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.constant.property",
        "variable.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#6CB6FF"
      }
    },
    {
      "name": "ALL_CAPS constant usage -> blue (web)",
      "scope": [
        "variable.other.constant",
        "variable.other.constant.object",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#6CB6FF"
      }
    },
    {
      "name": "operators -> blue (web)",
      "scope": [
        "keyword.operator.assignment",
        "keyword.operator.assignment.compound",
        "keyword.operator.comparison",
        "keyword.operator.relational",
        "keyword.operator.logical",
        "keyword.operator.arithmetic",
        "keyword.operator.bitwise",
        "keyword.operator.increment",
        "keyword.operator.decrement",
        "keyword.operator.ternary",
        "keyword.operator.arrow",
        "storage.type.function.arrow",
        "meta.arrow.ts storage.type.function.arrow",
        "meta.arrow storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#6CB6FF"
      }
    },
    {
      "name": "numbers -> dimmed green (user override)",
      "scope": [
        "constant.numeric",
        "constant.numeric.decimal",
        "constant.numeric.hex",
        "constant.numeric.integer",
        "constant.numeric.float"
      ],
      "settings": {
        "foreground": "#63EC63"
      }
    },
    {
      "name": "spread, type colon, optional -> default text (web)",
      "scope": [
        "keyword.operator.spread",
        "keyword.operator.rest",
        "keyword.operator.type.annotation",
        "keyword.operator.optional"
      ],
      "settings": {
        "foreground": "#D1D7E0"
      }
    },
    {
      "name": "builtin constructors String/Set/Promise -> orange (web)",
      "scope": [
        "support.class.builtin",
        "support.class.promise",
        "support.class.error",
        "new.expr entity.name.function"
      ],
      "settings": {
        "foreground": "#F69D50"
      }
    },
    {
      "name": "comment slashes follow comment override",
      "scope": [
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7CA964"
      }
    },
    {
      "name": "html tag names -> red",
      "scope": [
        "text.html entity.name.tag",
        "text.html entity.name.tag.html",
