{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "nightfall.tagged-template.injection",
  "injectionSelector": "L:source.js -comment -string, L:source.jsx -comment -string, L:source.js.jsx -comment -string, L:source.ts -comment -string, L:source.tsx -comment -string",
  "patterns": [
    {
      "include": "#tag-html"
    },
    {
      "include": "#tag-scss"
    },
    {
      "include": "#tag-less"
    },
    {
      "include": "#tag-css"
    },
    {
      "include": "#tag-sql"
    },
    {
      "include": "#tag-json"
    },
    {
      "include": "#tag-shell"
    },
    {
      "include": "#hint-html"
    },
    {
      "include": "#hint-scss"
    },
    {
      "include": "#hint-less"
    },
    {
      "include": "#hint-css"
    },
    {
      "include": "#hint-sql"
    },
    {
      "include": "#hint-json"
    },
    {
      "include": "#hint-shell"
    }
  ],
  "repository": {
    "template-substitution": {
      "begin": "\\$\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.begin.js"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.end.js"
        }
      },
      "name": "meta.template.expression.js",
      "contentName": "meta.embedded.line.js",
      "patterns": [
        {
          "include": "source.js"
        }
      ]
    },
    "tag-html": {
      "begin": "\\b((?i:html|htm))\\s*(`)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.tagged-template.js"
        },
        "2": {
          "name": "punctuation.definition.string.template.begin.js"
        }
      },
      "end": "(`)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.template.end.js"
        }
      },
      "contentName": "meta.embedded.block.html text.html.basic",
      "patterns": [
        {
          "include": "#template-substitution"
        },
        {
          "include": "text.html.basic"
        }
      ]
    },
    "tag-css": {
      "begin": "\\b((?i:css))\\s*(`)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.tagged-template.js"
        },
        "2": {
          "name": "punctuation.definition.string.template.begin.js"
        }
      },
      "end": "(`)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.template.end.js"
        }
      },
      "contentName": "meta.embedded.block.css source.css",
      "patterns": [
        {
          "include": "#template-substitution"
        },
        {
          "include": "source.css"
        }
      ]
    },
    "tag-scss": {
      "begin": "\\b((?i:scss))\\s*(`)",
