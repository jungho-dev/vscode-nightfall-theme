{
  "name": "urban-theme",
  "displayName": "Urban Theme",
  "description": "A dark color theme based on GitHub Dark Dimmed, with web-aligned token colors, key/value color distinction, and yellow brackets inside strings",
  "publisher": "JUNGHO",
  "icon": "logo.webp",
  "license": "Apache-2.0",
  "version": "1.1.8",
  "repository": {
    "type": "git",
    "url": "https://github.com/jungho-dev/urban-theme.git"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "color-theme",
    "dark",
    "github",
    "dimmed"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Urban Theme",
        "uiTheme": "vs-dark",
        "path": "./themes/urban-color-theme.json"
      }
    ],
    "grammars": [
      {
        "scopeName": "urban.bracket-in-string.injection",
        "path": "./syntaxes/bracket-in-string.tmLanguage.json",
        "injectTo": [
          "source.js",
          "source.jsx",
          "source.js.jsx",
          "source.ts",
          "source.tsx",
          "source.json",
          "source.json.comments",
          "source.jsonc",
          "source.java",
          "source.python",
          "source.css",
          "source.css.scss",
          "source.css.less",
          "text.html.basic",
          "text.html.derivative",
          "source.sql",
          "source.shell",
          "source.yaml",
          "source.toml",
          "source.rust",
          "source.go",
          "source.cs",
          "source.c",
          "source.cpp",
          "source.php",
          "source.ruby",
          "source.kotlin"
        ]
      },
      {
        "scopeName": "urban.tagged-template.injection",
        "path": "./syntaxes/tagged-template.tmLanguage.json",
        "injectTo": [
          "source.js",
          "source.jsx",
          "source.js.jsx",
          "source.ts",
          "source.tsx",
          "text.html.basic",
          "text.html.derivative"
        ]
      }
    ]
  },
  "engines": {
    "vscode": ">=1.110.0",
    "node": ">=21.0.0",
    "npm": ">=10.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "generate": "bun run src/build.ts",
    "validate": "bun run src/build.ts --check",
    "typecheck": "tsc --noEmit",
    "compile": "tsc",
    "bench": "bun run bench/tokenize-bench.mjs",
    "git": "bun run ~/.bootstrap/bootstrap-sync.ts --git",
    "swc": "bun run ~/.bootstrap/bootstrap-sync.ts --swc",
    "sync": "bun run ~/.bootstrap/bootstrap-sync.ts --sync",
    "tools": "bun run ~/.bootstrap/bootstrap-sync.ts --tools"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.1",
    "@swc/helpers": "^0.5.23",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.4.0",
    "@types/vscode": "1.110.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "mocha": "^11.8.0",
    "ts-morph": "^28.0.0",
    "ts-prune": "^0.10.3",
    "tsc-alias": "^1.9.2",
    "typescript": "^7.0.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
