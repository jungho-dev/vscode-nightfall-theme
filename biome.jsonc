{
  "$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
  "extends": ["../biome.jsonc"],
  "overrides": [
    {
      "includes": ["scripts/**", "bench/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off",
            "noTemplateCurlyInString": "off"
          },
          "security": {
            "noSecrets": "off"
          },
          "performance": {
            "noNamespaceImport": "off"
          }
        }
      }
    }
  ]
}
